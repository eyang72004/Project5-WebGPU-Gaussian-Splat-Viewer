struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    //TODO: information passed from vertex shader to fragment shader


    // Offset from the Gaussian center in normalized device coordinates
    @location(0) offset: vec2<f32>,


    // Inverse projected covariance for evaluating Gaussian falloff
    @location(1) conic: vec3<f32>,



    // Per-Gaussian opacity passed to the fragment shader
    @location(2) opacity: f32,



    // Per-Gaussian RGB color passed to the fragment shader
    @location(3) color: vec3<f32>,
};




struct Splat {
    //TODO: information defined in preprocess compute shader

    // Projected Gaussian center in normalized device coordinates
    center: vec2<f32>,

    // Inverse projected covariance, stored as (A, B, C)
    // Must match the storage layout in preprocess.wgsl
    conic: vec3<f32>,


    // Decoded per-Gaussian opacity in the range [0, 1]
    opacity: f32,

    // RGB color evaluated from spherical harmonics
    color: vec3<f32>,

};



// Read the projected splats generated by preprocessing
@group(0) @binding(0)
var<storage, read> splats: array<Splat>;




// Original Gaussian indices ordered by depth by the GPU radix sorter
@group(0) @binding(1)
var<storage, read> sorted_indices: array<u32>;



@vertex
fn vs_main(
    @builtin(vertex_index) vertex_index: u32,
    @builtin(instance_index) instance_index: u32
) -> VertexOutput {
    //TODO: reconstruct 2D quad based on information from splat, pass

    var out: VertexOutput;

    // Each Gaussian is rendered as two triangles (six vertices)
    // These unit corners (half-width 0.005) are rescaled below by radius_ndc to cover the projected three-sigma footprint
    let corners = array<vec2<f32>, 6>(
        vec2<f32>(-0.005, -0.005),
        vec2<f32>( 0.005, -0.005),
        vec2<f32>(-0.005,  0.005),
        vec2<f32>(-0.005,  0.005),
        vec2<f32>( 0.005, -0.005),
        vec2<f32>( 0.005,  0.005)
    );







    // Look up the original Gaussian index in the depth-sorted list
    let gaussian_idx = sorted_indices[instance_index];




    // Retrieve the projected center for this Gaussian
    let center = splats[gaussian_idx].center;



    // Retrieve the inverse projected covariance for this Gaussian
    let conic = splats[gaussian_idx].conic;


    // Recover the determinant of the inverse projected covariance
    let det_conic = conic.x * conic.z - conic.y * conic.y;


    // Recover the projected covariance from its inverse
    // Use a safe fallback for invisible Gaussians with zero conic
    var covariance = vec3<f32>(0.0, 0.0, 0.0);

    if (det_conic > 0.0) {
        let inv_det_conic = 1.0 / det_conic;

        // Original covariance coefficients (a, b, c)
        covariance = vec3<f32>(
            conic.z * inv_det_conic,
            -conic.y * inv_det_conic,
            conic.x * inv_det_conic
        );
    }



    // Compute the largest eigenvalue of the projected 2D covariance
    let a = covariance.x;
    let b = covariance.y;
    let c = covariance.z;

    let half_trace = 0.5 * (a + c);


    let eigen_discriminant = sqrt(max(0.0, 0.25 * (a - c) * (a - c) + b * b));

    let lambda_max = max(0.0, half_trace + eigen_discriminant);


    // Compute a three-standard-deviation bounding radius in NDC
    // This circular bound encloses the projected Gaussian's 3-sigma ellipse
    let radius_ndc = 3.0 * sqrt(lambda_max);



    // Scale the quad to enclose the Gaussian's three-sigma footprint
    let offset_ndc = corners[vertex_index] * (radius_ndc / 0.005);


    // Position the scaled quad around the projected Gaussian center
    out.position = vec4<f32>(
        center + offset_ndc,
        0.0,
        1.0
    );



    // Pass the vertex's displacement from the Gaussian center to the fragment shader
    out.offset = offset_ndc;



    // Pass the inverse projected covariance to the fragment shader
    out.conic = conic;



    // Pass the decoded per-Gaussian opacity to the fragment shader
    out.opacity = splats[gaussian_idx].opacity;


    // Pass the per-Gaussian RGB color to the fragment shader
    out.color = splats[gaussian_idx].color;



    return out;
}





@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    
    
    // Compute the quadratic form using the inverse 2D covariance
    let dx = in.offset.x;
    let dy = in.offset.y;

    let exponent = -0.5 * (in.conic.x * dx * dx + 2.0 * in.conic.y * dx * dy + in.conic.z * dy * dy);
   
   
    // Evaluate the Gaussian falloff from its quadratic exponent
    let gaussian_weight = exp(exponent);



    // Combine the Gaussian's learned opacity with its spatial falloff
    let alpha = in.opacity * gaussian_weight;


    // Discard fragments outside the Gaussian's three-sigma footprint
    if (gaussian_weight < exp(-4.5)) {
        discard;
    }
    
   
    // Render the Gaussian's RGB color with opacity-weighted transparency
    return vec4<f32>(
        in.color,
        alpha
    );

}
